# kanto-calibrated-spt-prior environment variables.
# Copy this file to `.env` and fill in actual paths / values for your local
# reproduction. Do NOT commit a populated .env file.

# Path to your local KuniJiban borehole extract (directory containing raw XML
# records). Obtain from https://www.kunijiban.pwri.go.jp/ (XML records cannot
# be redistributed by this repository).
KUNIJIBAN_DATA_DIR=

# (Optional) Path to your AIST 1:200,000 seamless geology cache.
# AIST_GEOLOGY_CACHE=

# (Optional) Path to your GSI DEM cache.
# GSI_DEM_CACHE=

# (Optional) Device for PyTorch training. One of: cpu, mps, cuda:0
# DEVICE=mps

# (Optional) Random seed for fold assignments (default 42 matches the paper).
# SEED=42

# (Optional) Output directory for derived artefacts. Default: ./outputs
# OUTPUT_DIR=./outputs
